#!/bin/sh
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/moob /tmp
fail() { echo "MOOBFS_VM_FAIL: $*"; dmesg | tail -60; poweroff -f; sleep 60; }
insmod /loop.ko || fail loop
insmod /moobfs.ko || fail module
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail mount
/mounted /data/expected.bin || fail reads
mount -o remount,rw /mnt/moob && fail writable-remount
umount /mnt/moob || fail unmount
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail remount
/mounted /data/expected.bin || fail repeated-reads
umount /mnt/moob || fail second-unmount
device=$(losetup -f) || fail free-loop
losetup "$device" /data/shared.img || fail loop-attach
/mounted --reject-rw "$device" || fail writable-mount
losetup -d "$device" || fail loop-detach
mount -t moobfs -o loop,ro /data/edges.img /mnt/moob || fail edge-mount
[ "$(wc -c < /mnt/moob/empty)" -eq 0 ] || fail empty
[ "$(cat /mnt/moob/tiny)" = x ] || fail tiny
[ "$(wc -c < /mnt/moob/maximum)" -eq 65536 ] || fail maximum
cmp /mnt/moob/maximum /data/source-2 || fail maximum-content
umount /mnt/moob || fail edge-unmount
count=0
for image in /data/bad-*.img; do
    mount -t moobfs -o loop,ro "$image" /mnt/moob && fail "accepted $image"
    count=$((count + 1))
done
[ "$count" -eq 15 ] || fail "bad fixture count $count"
rmmod moobfs || fail unload
if dmesg | grep -E 'BUG:|Oops:|WARNING:|Kernel panic|KASAN:'; then fail kernel-diagnostic; fi
echo "MOOBFS_VM_PASS: shared extents, independent inodes, reads, readonly, remount, 15 malformed images"

# Phases 2a/2b: memory layer stacked over ext4, btrfs and XFS (virtio disks vda, vdb, vdc).
for m in $(cat /mods/order); do insmod "/mods/$m" || fail "lower module $m"; done
insmod /moobfs_layer.ko || fail layer-module
mkdir -p /lower /mnt/layer
mount -t moobfs_layer none /mnt/layer && fail layer-mount-without-lower
mount -t moobfs_layer -o lower=/nonexistent none /mnt/layer && fail layer-mount-bad-lower
run_lower() {
    fs=$1; dev=$2; reflink=$3
    mount -t "$fs" "$dev" /lower || fail "lower-mount-$fs"
    mount -t moobfs_layer -o lower=/lower none /mnt/layer || fail "layer-mount-$fs"
    grep -q 'moobfs_layer' /proc/mounts || fail "layer-proc-mounts-$fs"
    mount -t moobfs_layer -o lower=/mnt/layer none /mnt && fail "layer-stack-on-itself-$fs"
    /layer /mnt/layer /lower "$reflink" links || fail "layer-tests-$fs"
    # typed attribute tools: write through the layer, check the lower tree
    echo memo > /mnt/layer/typed.md || fail "typed-create-$fs"
    /moobfs-attr set /mnt/layer/typed.md kind string decision || fail "attr-set-$fs"
    /moobfs-attr set /mnt/layer/typed.md created time 1760000000000000000 || fail "attr-time-$fs"
    /moobfs-attr set /mnt/layer/typed.md pinned bool true || fail "attr-bool-$fs"
    /moobfs-attr set /mnt/layer/typed.md score double 0.5 || fail "attr-double-$fs"
    [ "$(/moobfs-attr get /mnt/layer/typed.md kind)" = "$(printf 'kind\tstring\tdecision')" ] || fail "attr-get-$fs"
    [ "$(/moobfs-attr list /lower/typed.md | wc -l)" -eq 4 ] || fail "attr-list-lower-$fs"
    /moobfs-attr set /mnt/layer/typed.md Bad string x 2>/dev/null && fail "attr-badname-accepted-$fs"
    /moobfs-check /lower > /tmp/check.json || fail "check-clean-$fs"
    grep -q '"problem_count": 0' /tmp/check.json || fail "check-count-$fs"
    # plant an invalid encoding directly on the lower tree: the checker must flag it
    /moobfs-attr rawset /lower/typed.md broken 0402 || fail "rawset-lower-$fs"
    /moobfs-check /lower > /tmp/check.json; [ $? -eq 2 ] || fail "check-detects-$fs"
    grep -q 'payload is not a valid value' /tmp/check.json || fail "check-reason-$fs"
    /moobfs-attr get /mnt/layer/typed.md broken >/dev/null; [ $? -eq 2 ] || fail "attr-get-invalid-$fs"
    /moobfs-attr rm /mnt/layer/typed.md broken || fail "attr-rm-$fs"
    /moobfs-check /lower > /dev/null || fail "check-clean-again-$fs"
    rm /mnt/layer/typed.md || fail "typed-rm-$fs"
    # index and QUERY: the kernel answer must equal the user-space oracle on the lower tree
    same_query() {
        /query /mnt/layer "$@" > /tmp/k.txt || return 1
        /moobfs-index /lower "$@" > /tmp/o.txt || return 1
        cmp -s /tmp/k.txt /tmp/o.txt || { echo "kernel:"; cat /tmp/k.txt; echo "oracle:"; cat /tmp/o.txt; return 1; }
    }
    mkdir -p /mnt/layer/q/sub || fail "q-mkdir-$fs"
    for i in 1 2 3 4 5; do
        echo "memory $i" > /mnt/layer/q/f$i
        /moobfs-attr set /mnt/layer/q/f$i score int64 $((i * 10)) || fail "q-score-$fs"
    done
    /moobfs-attr set /mnt/layer/q/f1 kind string decision || fail "q-kind-$fs"
    /moobfs-attr set /mnt/layer/q/f2 kind string note || fail "q-kind-$fs"
    /moobfs-attr set /mnt/layer/q/f3 kind string decided || fail "q-kind-$fs"
    /moobfs-attr set /mnt/layer/q/f4 kind string note || fail "q-kind-$fs"
    /moobfs-attr set /mnt/layer/q/sub kind string folder || fail "q-kind-dir-$fs"
    /moobfs-attr set /mnt/layer/q/f2 pinned bool true || fail "q-pinned-$fs"
    /moobfs-attr set /mnt/layer/q/f5 pinned bool false || fail "q-pinned-$fs"
    /moobfs-attr set /mnt/layer/q/f3 weight double 0.75 || fail "q-double-$fs"
    /moobfs-attr set /mnt/layer/q/f4 weight double -2.5 || fail "q-double-$fs"
    /moobfs-attr set /mnt/layer/q/f1 raw raw deadbeef || fail "q-raw-$fs"
    same_query kind eq string decision || fail "query-eq-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 1 ] && grep -q 'q/f1$' /tmp/k.txt || fail "query-eq-content-$fs"
    same_query kind eq string note score ge int64 40 || fail "query-and-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 1 ] && grep -q 'q/f4$' /tmp/k.txt || fail "query-and-content-$fs"
    same_query kind prefix string dec || fail "query-prefix-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 2 ] || fail "query-prefix-count-$fs"
    same_query score gt int64 20 || fail "query-gt-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 3 ] || fail "query-gt-count-$fs"
    same_query score lt int64 0 || fail "query-empty-$fs"
    [ ! -s /tmp/k.txt ] || fail "query-empty-count-$fs"
    same_query pinned exists - - || fail "query-exists-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 2 ] || fail "query-exists-count-$fs"
    same_query pinned eq bool true || fail "query-bool-$fs"
    same_query weight lt double 0 || fail "query-double-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 1 ] && grep -q 'q/f4$' /tmp/k.txt || fail "query-double-content-$fs"
    same_query kind eq string folder || fail "query-dir-$fs"
    grep -q 'q/sub$' /tmp/k.txt || fail "query-dir-content-$fs"
    /query /mnt/layer raw exists - - > /tmp/k.txt || fail "query-raw-$fs"
    [ ! -s /tmp/k.txt ] || fail "query-raw-not-indexed-$fs"
    /query /mnt/layer invalid || fail "query-invalid-$fs"
    /query /mnt/layer info > /tmp/info.txt || fail "query-info-$fs"
    grep -q "lower=$fs" /tmp/info.txt || fail "query-info-lower-$fs"
    grep -q 'entries=1[0-9] inodes=6' /tmp/info.txt || { cat /tmp/info.txt; fail "query-info-counts-$fs"; }
    # updates: rename, directory rename, unlink and removexattr are reflected
    mv /mnt/layer/q/f1 /mnt/layer/q/g1 || fail "q-rename-$fs"
    same_query kind eq string decision || fail "query-renamed-$fs"
    grep -q 'q/g1$' /tmp/k.txt || fail "query-renamed-path-$fs"
    mv /mnt/layer/q /mnt/layer/r || fail "q-dir-rename-$fs"
    same_query kind eq string decision || fail "query-dir-renamed-$fs"
    grep -q 'r/g1$' /tmp/k.txt || fail "query-dir-renamed-path-$fs"
    rm /mnt/layer/r/f2 || fail "q-unlink-$fs"
    same_query kind eq string note || fail "query-unlinked-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 1 ] || fail "query-unlinked-count-$fs"
    /moobfs-attr rm /mnt/layer/r/f4 kind || fail "q-removexattr-$fs"
    same_query kind eq string note || fail "query-removexattr-$fs"
    [ ! -s /tmp/k.txt ] || fail "query-removexattr-count-$fs"
    # remount rebuilds the index from the lower tree
    umount /mnt/layer || fail "q-umount-$fs"
    mount -t moobfs_layer -o lower=/lower none /mnt/layer || fail "q-remount-$fs"
    same_query score ge int64 10 || fail "query-after-remount-$fs"
    [ "$(wc -l < /tmp/k.txt)" -eq 4 ] || fail "query-after-remount-count-$fs"
    same_query kind eq string decision || fail "query-after-remount-eq-$fs"
    grep -q 'r/g1$' /tmp/k.txt || fail "query-after-remount-path-$fs"
    umount /mnt/layer || fail "q-umount2-$fs"
    mount -t moobfs_layer -o lower=/lower,noindex none /mnt/layer || fail "q-noindex-mount-$fs"
    /query /mnt/layer score ge int64 10 > /dev/null 2>&1 && fail "query-noindex-answered-$fs"
    /query /mnt/layer info | grep -q 'flags=0x2' || fail "query-noindex-flag-$fs"
    umount /mnt/layer || fail "q-umount3-$fs"
    mount -t moobfs_layer -o lower=/lower,index_budget=1M none /mnt/layer || fail "q-budget-mount-$fs"
    same_query score ge int64 10 || fail "query-budget-$fs"
    umount /mnt/layer || fail "q-umount4-$fs"
    mount -t moobfs_layer -o lower=/lower none /mnt/layer || fail "q-remount-final-$fs"
    rm -rf /mnt/layer/r || fail "q-cleanup-$fs"
    mkdir -p /mnt/layer/fsx
    /fsx -q -N 5000 -S 1 /mnt/layer/fsx/file1 || fail "fsx-1-$fs"
    /fsx -q -N 3000 -S 2 -r 512 -w 512 /mnt/layer/fsx/file2 || fail "fsx-2-$fs"
    /fsx -q -N 1000 -S 3 -l 2000000 /mnt/layer/fsx/file3 || fail "fsx-large-$fs"
    cmp /mnt/layer/fsx/file1 /lower/fsx/file1 || fail "fsx-lower-mismatch-$fs"
    rm -rf /mnt/layer/fsx || fail "layer-cleanup-$fs"
    sync
    umount /mnt/layer || fail "layer-unmount-$fs"
    mount -t moobfs_layer -o lower=/lower,nolinks none /mnt/layer || fail "layer-remount-$fs"
    /layer /mnt/layer /lower "$reflink" nolinks || fail "layer-nolinks-tests-$fs"
    umount /mnt/layer || fail "layer-second-unmount-$fs"
    umount /lower || fail "lower-unmount-$fs"
    echo "LAYER_LOWER_PASS: $fs reflink=$reflink"
}
run_lower ext4 /dev/vda no
run_lower btrfs /dev/vdb yes
run_lower xfs /dev/vdc yes
rmmod moobfs_layer || fail layer-unload
if dmesg | grep -E 'BUG:|Oops:|WARNING:|Kernel panic|KASAN:'; then fail kernel-diagnostic-layer; fi
echo "MOOBFS_LAYER_PASS: pass-through over ext4, btrfs and xfs; layer tests; typed attributes and tools; index and QUERY equal to the oracle; fsx 9000 ops each; reflink on btrfs/xfs; nolinks; unload"
poweroff -f
