#!/bin/sh
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/moob
fail() { echo "MOOBFS_VM_FAIL: $*"; dmesg | tail -60; poweroff -f; sleep 60; }
insmod /loop.ko || fail loop
insmod /moobfs.ko || fail module
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail mount
/mounted /data/expected.bin || fail reads
mount -o remount,rw /mnt/moob && fail writable-remount
umount /mnt/moob || fail unmount
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail remount
/mounted /data/expected.bin || fail repeated-reads
umount /mnt/moob || fail second-unmount
device=$(losetup -f) || fail free-loop
losetup "$device" /data/shared.img || fail loop-attach
/mounted --reject-rw "$device" || fail writable-mount
losetup -d "$device" || fail loop-detach
mount -t moobfs -o loop,ro /data/edges.img /mnt/moob || fail edge-mount
[ "$(wc -c < /mnt/moob/empty)" -eq 0 ] || fail empty
[ "$(cat /mnt/moob/tiny)" = x ] || fail tiny
[ "$(wc -c < /mnt/moob/maximum)" -eq 65536 ] || fail maximum
cmp /mnt/moob/maximum /data/source-2 || fail maximum-content
umount /mnt/moob || fail edge-unmount
count=0
for image in /data/bad-*.img; do
    mount -t moobfs -o loop,ro "$image" /mnt/moob && fail "accepted $image"
    count=$((count + 1))
done
[ "$count" -eq 15 ] || fail "bad fixture count $count"
rmmod moobfs || fail unload
if dmesg | grep -E 'BUG:|Oops:|WARNING:|Kernel panic|KASAN:'; then fail kernel-diagnostic; fi
echo "MOOBFS_VM_PASS: shared extents, independent inodes, reads, readonly, remount, 15 malformed images"

# Phases 2a/2b: memory layer stacked over ext4, btrfs and XFS (virtio disks vda, vdb, vdc).
for m in $(cat /mods/order); do insmod "/mods/$m" || fail "lower module $m"; done
insmod /moobfs_layer.ko || fail layer-module
mkdir -p /lower /mnt/layer
mount -t moobfs_layer none /mnt/layer && fail layer-mount-without-lower
mount -t moobfs_layer -o lower=/nonexistent none /mnt/layer && fail layer-mount-bad-lower
run_lower() {
    fs=$1; dev=$2; reflink=$3
    mount -t "$fs" "$dev" /lower || fail "lower-mount-$fs"
    mount -t moobfs_layer -o lower=/lower none /mnt/layer || fail "layer-mount-$fs"
    grep -q 'moobfs_layer' /proc/mounts || fail "layer-proc-mounts-$fs"
    mount -t moobfs_layer -o lower=/mnt/layer none /mnt && fail "layer-stack-on-itself-$fs"
    /layer /mnt/layer /lower "$reflink" links || fail "layer-tests-$fs"
    mkdir -p /mnt/layer/fsx
    /fsx -q -N 5000 -S 1 /mnt/layer/fsx/file1 || fail "fsx-1-$fs"
    /fsx -q -N 3000 -S 2 -r 512 -w 512 /mnt/layer/fsx/file2 || fail "fsx-2-$fs"
    /fsx -q -N 1000 -S 3 -l 2000000 /mnt/layer/fsx/file3 || fail "fsx-large-$fs"
    cmp /mnt/layer/fsx/file1 /lower/fsx/file1 || fail "fsx-lower-mismatch-$fs"
    rm -rf /mnt/layer/fsx || fail "layer-cleanup-$fs"
    sync
    umount /mnt/layer || fail "layer-unmount-$fs"
    mount -t moobfs_layer -o lower=/lower,nolinks none /mnt/layer || fail "layer-remount-$fs"
    /layer /mnt/layer /lower "$reflink" nolinks || fail "layer-nolinks-tests-$fs"
    umount /mnt/layer || fail "layer-second-unmount-$fs"
    umount /lower || fail "lower-unmount-$fs"
    echo "LAYER_LOWER_PASS: $fs reflink=$reflink"
}
run_lower ext4 /dev/vda no
run_lower btrfs /dev/vdb yes
run_lower xfs /dev/vdc yes
rmmod moobfs_layer || fail layer-unload
if dmesg | grep -E 'BUG:|Oops:|WARNING:|Kernel panic|KASAN:'; then fail kernel-diagnostic-layer; fi
echo "MOOBFS_LAYER_PASS: pass-through over ext4, btrfs and xfs; layer tests; fsx 9000 ops each; reflink on btrfs/xfs; nolinks; unload"
poweroff -f
